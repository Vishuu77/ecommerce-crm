# ------------------------------------------------------------------ database
# Local (default) — SQLite, no setup needed.
# DATABASE_URL=sqlite:///./app/crm.db

# Cloud Postgres (set this for persistent data on Render/Railway/Fly)
# Without it, SQLite is used and data resets on every redeploy.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# ------------------------------------------------------------------ security
# Signs session cookies, the register->verify handoff, and OTP hashes.
# REQUIRED in production — without it every deploy uses the public dev default
# and anyone can forge a session. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_SECRET=change-me-to-a-long-random-string

# Show the OTP in the verify page + dev_otp cookie. Convenient locally; MUST be
# off in production or anyone can read a customer's OTP. Defaults to on when
# unset AND no WhatsApp channel is configured, so production with WhatsApp
# configured is safe by default — but set it to 0 explicitly to be sure.
# DEV_OTP=0

# ------------------------------------------------------------------ payments
# Razorpay (India: UPI / cards / netbanking). Leave unset to run in simulate
# mode — the full cart -> checkout -> paid flow works without keys.
# Get these from https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------ whatsapp
# Option A — local Baileys bridge (run `hermes whatsapp` to pair)
# WA_BRIDGE_URL=http://127.0.0.1:8765

# Option B — Meta WhatsApp Cloud API (works from any host, incl. cloud)
# WA_TOKEN=EAAG...
# WA_PHONE_ID=123456789012345

# With neither configured, notifications are written to the `notifications`
# table with status='simulated' (full audit trail, nothing is sent).
